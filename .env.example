# Copia este archivo a .env.local y llena los valores.
# .env.local NO se sube a git.

# Cadena de conexión de Neon (Dashboard → tu proyecto → Connection string → "pooled")
DATABASE_URL="postgresql://usuario:password@host.neon.tech/neondb?sslmode=require"

# Secreto de sesión. Genéralo con:  npx auth secret
AUTH_SECRET=""

# Credenciales OAuth de Google Cloud Console
# (APIs y servicios → Credenciales → ID de cliente de OAuth → Aplicación web)
# URI de redirección autorizado en desarrollo:
#   http://localhost:3000/api/auth/callback/google
# En producción:
#   https://TU-DOMINIO.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# CRÍTICO: sin esta lista, cualquier persona con cuenta de Google entraría a tus
# finanzas. Solo estos correos pueden iniciar sesión. Separa varios con comas.
ALLOWED_EMAILS="tu-correo@gmail.com"
